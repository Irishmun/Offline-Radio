<Project Sdk="Microsoft.NET.Sdk">

	<!--
    Set the BuildPlatform property to the Eto platform you wish to build for.
    The default is the platform you are building on.
    Valid values: Wpf, Windows, Mac64, XamMac2, Gtk, Direct2D
  -->

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<Copyright>Copyright Steef van de Weijdeven © 2025</Copyright>
		<FileVersion>1.3.0.0</FileVersion>
		<AssemblyVersion>1.3.0.0</AssemblyVersion>
		<!--<RuntimeIdentifiers>win-x64;osx-x64;linux-x64</RuntimeIdentifiers>-->
		<Platform>Windows</Platform>
		<OutputType>WinExe</OutputType>
		<StartupObject />
	</PropertyGroup>

	<ItemGroup>
		<Content Include="icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Eto.Forms" Version="2.10.2" />
		<PackageReference Include="Eto.Platform.Windows" Version="2.10.2" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="NAudio.Core" Version="2.2.1" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="RadioForm.eto.cs">
			<DependentUpon>RadioForm.cs</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>